{
	"schemaVersion": 1,
	"id": "celestium",
	"version": "${version}",
	"name": "Celestium",
	"description": "Unlock a whole new set of armor and tools forged by the strongest and rarest materials in the game",
	"authors": [
		"InxlingGamer"
	],
	"contact": {
		"homepage": "https://github.com/InxlingGamer/celestium",
		"sources": "https://github.com/InxlingGamer/celestium"
	},
	"license": "MIT",
	"icon": "assets/celestium/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.inklinggamer.celestium.Celestium"
		],
		"fabric-datagen": [
			"net.inklinggamer.celestium.CelestiumDataGenerator"
		],
		"client": [
			"net.inklinggamer.celestium.CelestiumClient"
		]
	},
	"mixins": [
		"celestium.mixins.json",
		{
			"config": "celestium.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "=1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"iris": "*"
	}
}
